{
  "name": "@chbrain/khai-misfits",
  "version": "0.315.0",
  "description": "khai misfits: the Misfits production house. Misfits staged with khai; the source is credited where it is in the public domain.",
  "type": "module",
  "exports": {
    ".": "./package.json",
    "./package.json": "./package.json",
    "./registry.json": "./registry.json"
  },
  "license": "SEE LICENSE IN LICENSE and LICENSE-CODE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChBrain/khai-misfits.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "misfits/**",
    "registry.json",
    "README.md",
    "LICENSE",
    "LICENSE-CODE"
  ],
  "khai": {
    "engine": "misfits",
    "collection": {
      "dir": "misfits",
      "key": "misfits",
      "anchor": "play_"
    },
    "card": {
      "wire": "The Misfits production house: a collection of khai plays staged as misfits."
    }
  },
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "science": "npx khai-tests science build",
    "version": "changeset version && npx khai-tests registry build && npx khai-tests science build && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@chbrain/khai-arch": "^0.1.25",
    "@chbrain/khai-guard": "^0.1.24",
    "@chbrain/khai-language": "^0.1.23",
    "@chbrain/khai-pack": "^0.0.3",
    "@chbrain/khai-review": "^0.1.4",
    "@chbrain/khai-tests": "^0.2.8",
    "husky": "^9.1.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
