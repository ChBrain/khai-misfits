{
  "source": ["misfits/**"],
  "test": ["tests/**", ".github/workflows/**", ".husky/**"],
  "exemptRenames": true,
  "changesetPolicy": {
    "countDrivenAdd": ["misfits/*/play_*.md"]
  },
  "licensePolicy": {
    "packages": ["package.json"],
    "packageLicenses": ["SEE LICENSE IN LICENSE and LICENSE-CODE"]
  },
  "branchScope": {
    "shared": [
      ".changeset/**",
      "package.json",
      "package-lock.json",
      "CHANGELOG.md",
      ".prettierrc",
      ".prettierignore",
      ".gitignore",
      ".npmrc",
      ".nvmrc",
      "LICENSE",
      "LICENSE-CODE",
      "SECURITY.md",
      "registry.json",
      "docs/SCIENCE.md",
      "REFERENCES.md"
    ],
    "riders": [
      {
        "pattern": "management/orders/**",
        "fallback": "governance"
      },
      {
        "pattern": "management/plan_fill_the_season.md",
        "fallback": "governance"
      }
    ],
    "lanes": [
      {
        "pattern": "misfit/*",
        "layer": "solution",
        "allow": ["misfits/**"]
      },
      {
        "pattern": "governance/*",
        "layer": "governance",
        "allow": [
          ".github/**",
          ".husky/**",
          "khai-guard.config.json",
          "tests/**",
          "README.md",
          "GEMINI.md",
          "CLAUDE.md",
          "REFERENCE.md",
          "REFERENCES.md",
          "management/**"
        ]
      },
      {
        "pattern": "changeset-release/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "dependabot/*",
        "layer": "general",
        "allow": ["**/package.json", "**/package-lock.json", ".github/workflows/**"]
      },
      {
        "pattern": "chore/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "fix/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "docs/*",
        "layer": "general",
        "allow": []
      }
    ]
  },
  "scholarPolicy": {
    "homonyms": {
      "Adams": ["Scott", "Gordon", "John", "Robert McC", "Robert Merrihew"],
      "Black": ["Duncan", "William C"],
      "Brown": ["Graham", "James K", "Stephen J"],
      "Christensen": ["Clayton", "Thomas J"],
      "Cook": ["Richard", "Terry"],
      "Fine": ["Jason", "Paul"],
      "Freeman": ["J Leiper", "Jo"],
      "Gray": ["J A Muir", "Robert"],
      "Greene": ["David L", "David", "Mark"],
      "Hart": ["'t", "Julian Tudor", "Oliver"],
      "Hirshleifer": ["David", "Jack"],
      "Kessler": ["Daniel", "Friedrich", "Donald"],
      "Lawrence": ["Thomas B", "Paul R"],
      "Levitt": ["Barbara", "Theodore", "Steven"],
      "Luchins": ["Abraham S", "Edith H"],
      "Lynch": ["Michael", "Nancy"],
      "Martin": ["Brian", "Thomas", "Daniel P"],
      "Miller": ["Wendi", "Dale", "Geoffrey", "Franklin", "Edward M"],
      "Nelson": ["Leif", "Robert A"],
      "Pauly": ["Mark", "Daniel"],
      "Pierce": ["Jon", "W David"],
      "Robinson": ["Sandra", "Robert"],
      "Rose": ["Geoffrey", "Michael R", "Todd"],
      "Schwartz": ["Alan", "Lisa", "Anna", "Barry"],
      "Snyder": ["Glenn", "Jack"],
      "Spearman": ["Mark", "Charles"],
      "Wagner": ["Adolph", "Richard"],
      "Wang": ["Zhanyun", "Liangyan"],
      "White": ["Lawrence J", "Leslie A", "Gilbert F"],
      "Wilde": ["Gerald J S", "Louis"]
    }
  },
  "driftPolicy": {
    "scopes": ["@chbrain/"]
  },
  "workPolicy": {
    "contrastMarkers": [
      "cited to distinguish",
      "cited to mark the line",
      "distinction only",
      "distinction.",
      "the neighbour, held clear",
      "the cousin, and the difference",
      "the classical effect it is named against",
      "held near",
      "held clear",
      "(contrast)"
    ],
    "canon": [
      "Industrial Dynamics",
      "Thinking in Systems: A Primer",
      "Business Dynamics: Systems Thinking and Modeling",
      "Prospect Theory: An Analysis of Decision under Risk",
      "The General Theory of Employment, Interest and Money",
      "The Logic of Collective Action",
      "The Rise and Decline of Nations",
      "The Strategy of Conflict",
      "Regression towards Mediocrity in Hereditary Stature",
