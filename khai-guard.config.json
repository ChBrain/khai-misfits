{
  "source": ["misfits/**"],
  "test": ["tests/**", ".github/workflows/**", ".husky/**"],
  "exemptRenames": true,
  "changesetPolicy": {
    "countDrivenAdd": ["misfits/*/play_*.md"]
  },
  "licensePolicy": {
    "packages": ["package.json"],
    "packageLicenses": ["SEE LICENSE IN LICENSE and LICENSE-CODE"]
  },
  "branchScope": {
    "shared": [
      ".changeset/**",
      "package.json",
      "package-lock.json",
      "CHANGELOG.md",
      ".prettierrc",
      ".prettierignore",
      ".gitignore",
      ".npmrc",
      ".nvmrc",
      "LICENSE",
      "LICENSE-CODE",
      "SECURITY.md",
      "registry.json",
      "docs/SCIENCE.md"
    ],
    "riders": [
      {
        "pattern": "management/orders/**",
        "fallback": "governance"
      }
    ],
    "lanes": [
      {
        "pattern": "misfit/*",
        "layer": "solution",
        "allow": ["misfits/**"]
      },
      {
        "pattern": "governance/*",
        "layer": "governance",
        "allow": [
          ".github/**",
          ".husky/**",
          "khai-guard.config.json",
          "tests/**",
          "README.md",
          "GEMINI.md",
          "CLAUDE.md",
          "REFERENCE.md",
          "REFERENCES.md",
          "management/**"
        ]
      },
      {
        "pattern": "changeset-release/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "dependabot/*",
        "layer": "general",
        "allow": ["**/package.json", "**/package-lock.json", ".github/workflows/**"]
      },
      {
        "pattern": "chore/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "fix/*",
        "layer": "general",
        "allow": []
      },
      {
        "pattern": "docs/*",
        "layer": "general",
        "allow": []
      }
    ]
  },
  "scholarPolicy": {
    "homonyms": {
      "Adams": ["Scott", "Gordon", "John"],
      "Black": ["Duncan", "William C"],
      "Christensen": ["Clayton", "Thomas J"],
      "Fine": ["Jason", "Paul"],
      "Freeman": ["J Leiper", "Jo"],
      "Gray": ["J A Muir", "Robert"],
      "Hart": ["'t", "Julian Tudor", "Oliver"],
      "Kessler": ["Daniel", "Friedrich"],
      "Luchins": ["Abraham S", "Edith H"],
      "Lynch": ["Michael", "Nancy"],
      "Martin": ["Brian", "Thomas"],
      "Rose": ["Geoffrey", "Michael R", "Todd"],
      "Schwartz": ["Alan", "Lisa"],
      "Snyder": ["Glenn", "Jack"],
      "Wagner": ["Adolph", "Richard"],
      "White": ["Lawrence J", "Leslie A"],
      "Wilde": ["Gerald J S", "Louis"]
    }
  },
  "driftPolicy": {
    "scopes": ["@chbrain/"]
  },
  "workPolicy": {
    "contrastMarkers": [
      "cited to distinguish",
      "cited to mark the line",
      "distinction only",
      "distinction.",
      "the neighbour, held clear",
      "the cousin, and the difference",
      "the classical effect it is named against",
      "held near",
      "held clear",
      "(contrast)"
    ],
    "canon": [],
    "aliases": {}
  }
}
